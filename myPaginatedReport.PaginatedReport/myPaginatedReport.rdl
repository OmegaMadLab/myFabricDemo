  <DataSources>
    <DataSource Name="us_population_county_area">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-ae214241-f30e-492e-89a8-7686797f5365;Integrated Security=ClaimsToken</ConnectString>
