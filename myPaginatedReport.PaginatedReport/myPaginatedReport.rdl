  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>us_population_county_area</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP('us_population_county_area'[AA], 'us_population_county_area'[Aruba]), "IsGrandTotalRowTotal"
		),
		"Sumv180", CALCULATE(SUM('us_population_county_area'[180]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'us_population_county_area'[AA],
	'us_population_county_area'[Aruba]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('us_population_county_area'[AA], 'us_population_county_area'[Aruba]), "IsGrandTotalRowTotal"
			),
			"Sumv180", CALCULATE(SUM('us_population_county_area'[180]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'us_population_county_area'[AA],
			1,
			'us_population_county_area'[Aruba],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'us_population_county_area'[AA],
	'us_population_county_area'[Aruba]</wa:PreviewCommandText>
      </Query>
